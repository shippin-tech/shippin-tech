FROM node:22-bookworm-slim AS ui
WORKDIR /src
COPY ui/package.json ui/package-lock.json ui/
RUN cd ui && npm ci
COPY resources/schema/schema.json.gz resources/schema/schema.json.gz
COPY assets/webui/assets/*.woff2 assets/webui/assets/
COPY deploy/control-plan.template.json deploy/control-plan.template.json
COPY ui/ ui/
RUN cd ui && npm run build
FROM nginx:alpine
COPY --from=ui /src/ui/build /usr/share/nginx/html
COPY deploy/local/nginx.conf /etc/nginx/conf.d/default.conf
