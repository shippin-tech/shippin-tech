COMPOSE_PROJECT_NAME=shippin-test-1
SHIPPIN_IMAGE=ghcr.io/shippin-tech/shippin-tech-scale:sha-REPLACE_WITH_FULL_COMMIT
MAIL_HOSTNAME=mail-test-1.example.com
# Permanent administrator for the portal: sign in at /login as the user before the
# colon. Works in every mode, so this never changes unless you change it here.
RECOVERY_ADMIN=admin:replace-with-a-long-random-password
# Image tag that auto-update.sh follows (default: release).
#SHIPPIN_CHANNEL=release
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=shippin-test
S3_REGION=us-east-1
NATS_ADDRESS=nats.internal.example.com:4222
# Loopback by default. Set individual bindings to the server IP when ready.
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
MAIL_BIND=127.0.0.1
# Host-side ports. Keep defaults for one instance per host/IP, or assign unique
# values per instance when multiple nodes run on one host.
HTTP_HOST_PORT=8080
SMTP_HOST_PORT=25
SMTPS_HOST_PORT=465
SUBMISSION_HOST_PORT=587
IMAPS_HOST_PORT=993
HTTPS_HOST_PORT=443
