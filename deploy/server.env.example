# install.sh writes this file for you. Copy it by hand only for a manual install.
COMPOSE_PROJECT_NAME=shippin-mail
# "bundled" runs FoundationDB, object storage and NATS on this host with persistent
# data. Remove it to use your own: then set S3_*, NATS_ADDRESS and put your
# FoundationDB cluster file at ./fdb.cluster.
COMPOSE_PROFILES=bundled
SHIPPIN_IMAGE=ghcr.io/shippin-tech/shippin-tech-scale:sha-REPLACE_WITH_FULL_COMMIT
MAIL_HOSTNAME=mail.example.com
# Optional break-glass administrator (admin:<long password>). Leave empty and a new
# server prints a one-time setup key for "admin" instead; signing in with it makes
# you create your own administrator, and the key then stops working.
RECOVERY_ADMIN=
# Hours the setup key works for, counted from when it was made (1 to 720). After that,
# restarting the server prints a new one.
SETUP_KEY_HOURS=24
# Image tag that auto-update.sh follows (default: release).
#SHIPPIN_CHANNEL=release
# Object storage and NATS. These values match the bundled services.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=shippin
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=mail
S3_REGION=us-east-1
NATS_ADDRESS=nats:4222
# Free plan. Customers sign up at https://MAIL_HOSTNAME/signup with a domain they
# prove they own by DNS, then manage their mailboxes at /manage.
PANEL_SIGNUP=closed
PANEL_MAX_DOMAINS=100
PANEL_MAILBOXES=5
PANEL_ALIASES=20
PANEL_MAILBOX_MB=1024
PANEL_SIGNUPS_PER_HOUR=10
# Messages each signed-in sender may send per day. Applied once, on the first
# signup; change it afterwards in the portal under inbound throttles.
PANEL_SENDS_PER_DAY=200
# Listening addresses. The HTTP management port stays on loopback; mail and HTTPS
# face the internet once DNS and the firewall are ready.
HTTP_BIND=127.0.0.1
HTTPS_BIND=0.0.0.0
MAIL_BIND=0.0.0.0
# Host-side ports. Keep defaults for one instance per host/IP, or assign unique
# values per instance when multiple nodes run on one host.
HTTP_HOST_PORT=8080
SMTP_HOST_PORT=25
SMTPS_HOST_PORT=465
SUBMISSION_HOST_PORT=587
IMAPS_HOST_PORT=993
HTTPS_HOST_PORT=443

# Google Drive link (optional; see deploy/README.md). Off unless all three are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://mail.example.org/api/google/callback

# Domains shared with another mail system such as Google Workspace; see
# deploy/HYBRID-GOOGLE-WORKSPACE.md.
# SPLIT_DOMAINS=angrygaming.org

# How many days stored mail traces are kept (default 7).
# TRACE_DAYS=7
# How long deleted mail and accounts are kept, 0 to keep nothing.
# KEEP_DELETED_DAYS=30
# Masked addresses one person can have.
# MASKED_LIMIT=50
