{
  "name": "@shippin/ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "tokens": "node --experimental-strip-types scripts/emit-fluid.ts && node --experimental-strip-types scripts/emit-portal.ts",
    "predev": "npm run tokens",
    "prebuild": "svelte-kit sync && npm run tokens",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@xyflow/svelte": "^1.7.1",
    "bits-ui": "^2.20.6",
    "layerchart": "^2.9.2",
    "svelte": "^5.28.0",
    "svelte-check": "^4.1.6",
    "typescript": "^5.8.3",
    "utopia-core": "^1.6.0",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  }
}
